# Cloudflare Turnstile
# Public site key; embedded in the browser bundle during `next build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only secret used to verify Turnstile tokens.
TURNSTILE_SECRET=

# SMTP mail delivery (port 587 with STARTTLS)
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
# Sender permitted or verified by the SMTP provider, e.g. Name <sender@example.com>
MAIL_FROM=
# Address that receives contact-form submissions.
MAIL_TO=
